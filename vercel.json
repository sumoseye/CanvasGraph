{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
      "app": {
        "root": ".",
        "framework": "fastapi",
        "entrypoint": "backend/main.py"
      },
      "frontend": {
        "root": "frontend",
        "framework": "vite"
      }
    },
    "rewrites": [
      {
        "source": "/api/(.*)",
        "destination": {
          "service": "app"
        }
      },
      {
        "source": "/(.*)",
        "destination": {
          "service": "frontend"
        }
      }
    ]
  }